root = true

[*.cs]

# SA0001 XML comment analysis disabled
dotnet_diagnostic.SA0001.severity = none

# SA1200: Using directives should be placed correctly
dotnet_diagnostic.SA1200.severity = none

# SA1633: File must have a header
dotnet_diagnostic.SA1633.severity = none

# SA1600: Elements must be documented
dotnet_diagnostic.SA1600.severity = none

# SA1101: Prefix local calls with 'this.'
dotnet_diagnostic.SA1101.severity = none

# --- HANDLE .NET ANALYZERS (CAxxxx) ---

# CA1812: Internal class that is apparently never instantiated.
dotnet_diagnostic.CA1812.severity = suggestion

# CA1848
dotnet_diagnostic.CA1848.severity = suggestion

# CA1062
dotnet_diagnostic.CA1062.severity = suggestion

# CA1031 Catch more specific allowed excaption type
dotnet_diagnostic.CA1031.severity = suggestion

# CA2007 Catch more specific allowed excaption type
dotnet_diagnostic.CA2007.severity = suggestion