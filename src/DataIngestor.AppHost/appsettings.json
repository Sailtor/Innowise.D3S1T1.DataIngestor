{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Integrations": {
    "WeakAPI": {
      "URL": "*",
      "ApiKey": "*",
      "Resilience": {
        "TotalRequestTimeout": { "Timeout": "00:00:30" },
        "Retry": {
          "MaxRetryAttempts": 5,
          "BackoffType": "Exponential",
          "UseJitter": true,
          "Delay": "00:00:02"
        },
        "CircuitBreaker": {
          "SamplingDuration": "00:00:30",
          "FailureRatio": 0.5,
          "MinimumThroughput": 5,
          "BreakDuration": "00:00:15"
        },
        "AttemptTimeout": { "Timeout": "00:00:03" }
      }
    }
  },
  "AllowedHosts": "*",
  "RabbitMQ": {
    "Host": "*",
    "VirtualHost": "/",
    "Username": "*",
    "Password": "*"
  },
  "Quartz": {
    "quartz.scheduler.instanceName": "Metric reader"
  }
}
